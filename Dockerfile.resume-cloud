FROM python:3.12-slim AS build
WORKDIR /app
COPY pyproject.toml README.md ./
RUN python -c "import tomllib; p=tomllib.load(open('pyproject.toml','rb')); open('/tmp/requirements.txt','w').write('\\n'.join(p['project']['dependencies'] + p['project']['optional-dependencies']['cloud']))"
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY src ./src
COPY .agents ./.agents
RUN pip install --no-cache-dir --no-deps .

FROM python:3.12-slim
RUN useradd --create-home --uid 10001 app
WORKDIR /app
COPY --from=build /usr/local /usr/local
COPY --chown=app:app migrations ./migrations
COPY --chown=app:app scripts/migrate_resume_cloud.py ./scripts/migrate_resume_cloud.py
USER app
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health/live', timeout=2)"
CMD ["python", "-m", "soloscale.resume_cloud_api"]
