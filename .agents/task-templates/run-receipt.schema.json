{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://soloscale.local/schemas/skill-run-receipt-1.0.json",
  "title": "SoloScale Skill Run Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "task_id", "normalized_task_envelope", "selected_skills", "routing_reason", "phase_routes", "tools_and_commands", "repositories", "evidence_bundle_ids", "input_hashes", "output_artifacts", "deterministic_checks", "human_gates", "approvals", "failures", "retries", "final_status", "started_at", "completed_at", "external_outcome_ids", "proposed_skill_update", "outcome_state"],
  "$defs": {
    "selected_skill": {"type": "object", "additionalProperties": false, "required": ["name", "version", "status", "reason"], "properties": {"name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}, "status": {"enum": ["DRAFT", "CANDIDATE", "ACTIVE", "DEPRECATED", "BLOCKED"]}, "reason": {"type": "string", "minLength": 1, "maxLength": 500}}},
    "phase_route": {"type": "object", "additionalProperties": false, "required": ["phase", "recommended", "actual_provider_used", "actual_model_used", "actual_reasoning_effort", "actual_agent_used"], "properties": {"phase": {"enum": ["discovery", "decision", "implementation", "verification", "review"]}, "recommended": {"type": "string", "minLength": 1, "maxLength": 120}, "actual_provider_used": {"type": ["string", "null"], "maxLength": 120}, "actual_model_used": {"type": ["string", "null"], "maxLength": 120}, "actual_reasoning_effort": {"type": ["string", "null"], "maxLength": 80}, "actual_agent_used": {"type": ["string", "null"], "maxLength": 120}}},
    "repository": {"type": "object", "additionalProperties": false, "required": ["repository", "branch", "sha"], "properties": {"repository": {"type": "string", "minLength": 1, "maxLength": 500}, "branch": {"type": "string", "minLength": 1, "maxLength": 300}, "sha": {"type": "string", "pattern": "^[0-9a-f]{40,64}$"}}},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["artifact_id", "sha256"], "properties": {"artifact_id": {"type": "string", "minLength": 1, "maxLength": 200}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "check": {"type": "object", "additionalProperties": false, "required": ["name", "status", "detail"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 200}, "status": {"enum": ["PASSED", "FAILED", "NOT_RUN"]}, "detail": {"type": ["string", "null"], "maxLength": 1000}}},
    "failure": {"type": "object", "additionalProperties": false, "required": ["phase", "summary", "hypothesis"], "properties": {"phase": {"type": "string", "minLength": 1, "maxLength": 80}, "summary": {"type": "string", "minLength": 1, "maxLength": 1000}, "hypothesis": {"type": ["string", "null"], "maxLength": 1000}}},
    "outcome_state": {"type": "object", "additionalProperties": false, "required": ["workflow_completed", "artifact_generated", "human_approved", "externally_published_or_submitted", "external_outcome_observed"], "properties": {"workflow_completed": {"type": "boolean"}, "artifact_generated": {"type": "boolean"}, "human_approved": {"type": "boolean"}, "externally_published_or_submitted": {"type": "boolean"}, "external_outcome_observed": {"type": "boolean"}}, "allOf": [{"if": {"properties": {"externally_published_or_submitted": {"const": true}}, "required": ["externally_published_or_submitted"]}, "then": {"properties": {"human_approved": {"const": true}, "artifact_generated": {"const": true}}}}, {"if": {"properties": {"external_outcome_observed": {"const": true}}, "required": ["external_outcome_observed"]}, "then": {"properties": {"externally_published_or_submitted": {"const": true}}}}]}
  },
  "properties": {
    "receipt_id": {"type": "string", "pattern": "^skill-run-[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}$"}, "task_id": {"type": "string", "pattern": "^skill-task-[0-9a-f]{12}$"},
    "normalized_task_envelope": {"$ref": "task-envelope.schema.json"}, "selected_skills": {"type": "array", "items": {"$ref": "#/$defs/selected_skill"}, "minItems": 1}, "routing_reason": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1},
    "phase_routes": {"type": "array", "items": {"$ref": "#/$defs/phase_route"}, "minItems": 5, "maxItems": 5, "allOf": [{"contains": {"properties": {"phase": {"const": "discovery"}}}}, {"contains": {"properties": {"phase": {"const": "decision"}}}}, {"contains": {"properties": {"phase": {"const": "implementation"}}}}, {"contains": {"properties": {"phase": {"const": "verification"}}}}, {"contains": {"properties": {"phase": {"const": "review"}}}}]},
    "tools_and_commands": {"type": "array", "items": {"type": "string", "minLength": 1}}, "repositories": {"type": "array", "items": {"$ref": "#/$defs/repository"}}, "evidence_bundle_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "input_hashes": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "required": ["operator_request"]},
    "output_artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}, "deterministic_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}}, "human_gates": {"type": "array", "items": {"type": "string", "minLength": 1}}, "approvals": {"type": "array", "items": {"type": "string", "minLength": 1}}, "failures": {"type": "array", "items": {"$ref": "#/$defs/failure"}}, "retries": {"type": "integer", "minimum": 0, "maximum": 2}, "final_status": {"enum": ["ROUTED", "AWAITING_HUMAN_GATE", "COMPLETED", "FAILED"]}, "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"}, "external_outcome_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}, "proposed_skill_update": {"enum": ["NO_SKILL_CHANGE", "CREATE_CANDIDATE_SKILL", "PROPOSE_SKILL_UPDATE", "DEPRECATE_SKILL"]}, "outcome_state": {"$ref": "#/$defs/outcome_state"}
  },
  "allOf": [
    {"if": {"properties": {"final_status": {"const": "ROUTED"}}, "required": ["final_status"]}, "then": {"properties": {"outcome_state": {"properties": {"workflow_completed": {"const": false}, "artifact_generated": {"const": false}, "human_approved": {"const": false}, "externally_published_or_submitted": {"const": false}, "external_outcome_observed": {"const": false}}}}}},
    {"if": {"properties": {"final_status": {"const": "AWAITING_HUMAN_GATE"}}, "required": ["final_status"]}, "then": {"properties": {"human_gates": {"minItems": 1}, "outcome_state": {"properties": {"workflow_completed": {"const": false}, "externally_published_or_submitted": {"const": false}, "external_outcome_observed": {"const": false}}}}}},
    {"if": {"properties": {"final_status": {"const": "COMPLETED"}}, "required": ["final_status"]}, "then": {"properties": {"outcome_state": {"properties": {"workflow_completed": {"const": true}}}}}},
    {"if": {"properties": {"final_status": {"const": "FAILED"}}, "required": ["final_status"]}, "then": {"properties": {"outcome_state": {"properties": {"workflow_completed": {"const": false}}}}}},
    {"if": {"properties": {"outcome_state": {"properties": {"human_approved": {"const": true}}, "required": ["human_approved"]}}}, "then": {"properties": {"approvals": {"minItems": 1}}}},
    {"if": {"properties": {"outcome_state": {"properties": {"externally_published_or_submitted": {"const": true}}, "required": ["externally_published_or_submitted"]}}}, "then": {"properties": {"external_outcome_ids": {"minItems": 1}}}},
    {"if": {"properties": {"external_outcome_ids": {"minItems": 1}}, "required": ["external_outcome_ids"]}, "then": {"properties": {"outcome_state": {"anyOf": [{"properties": {"externally_published_or_submitted": {"const": true}}, "required": ["externally_published_or_submitted"]}, {"properties": {"external_outcome_observed": {"const": true}}, "required": ["external_outcome_observed"]}]}}}}
  ]
}
